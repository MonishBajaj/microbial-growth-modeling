{
  "manifest_version": 3,
  "name": "ThermoWorks App Check Helper",
  "version": "1.3.0",
  "description": "Mints ThermoWorks App Check in-page, POSTs the token to your dashboard, and renews it in a background tab during runs.",
  "permissions": ["storage", "tabs", "scripting"],
  "host_permissions": [
    "https://cloud.thermoworks.com/*",
    "https://*.onrender.com/*",
    "https://*.trycloudflare.com/*",
    "https://content-firebaseappcheck.googleapis.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.onrender.com/*",
        "https://*.trycloudflare.com/*",
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": ["dashboard_bridge.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "ThermoWorks App Check Helper",
    "default_popup": "popup.html"
  }
}
